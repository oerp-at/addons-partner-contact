<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form - partner_company_manual</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div/group/label[@for='name']" position="before">
                <div colspan="2" name="company_type_toggle">
                    <field name="is_company" invisible="1" />
                    <field
                        name="company_type"
                        widget="radio"
                        options="{'horizontal': true}"
                    />
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="name">res.partner.simplified.form - partner_company_manual</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="before">
                <field name="is_company" invisible="1" />
                <field
                    name="company_type"
                    widget="radio"
                    options="{'horizontal': true}"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>
</odoo>
