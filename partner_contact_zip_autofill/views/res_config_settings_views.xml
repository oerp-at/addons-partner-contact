<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.partner_contact_zip_autofill</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="integration" position="inside">
                <setting
                    id="at_address_autofill_setting"
                    string="Address Autofill (AT)"
                    help="Fill country, city and state on contacts from the Austrian ZIP directory."
                >
                    <field name="at_address_autofill_enabled" />
                    <div class="mt-2" invisible="not at_address_autofill_enabled">
                        <button
                            name="action_import_zip_directory_at"
                            type="object"
                            string="Import ZIP Directory (AT)"
                            class="btn-secondary"
                        />
                    </div>
                </setting>
                <setting
                    id="de_address_autofill_setting"
                    string="Address Autofill (DE)"
                    help="Fill country, city and state on contacts from the German ZIP directory."
                >
                    <field name="de_address_autofill_enabled" />
                    <div class="mt-2" invisible="not de_address_autofill_enabled">
                        <button
                            name="action_import_zip_directory_de"
                            type="object"
                            string="Import ZIP Directory (DE)"
                            class="btn-secondary"
                        />
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
