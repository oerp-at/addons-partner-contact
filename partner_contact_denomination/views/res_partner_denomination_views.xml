<odoo>
    <record id="res_partner_denomination_view_list" model="ir.ui.view">
        <field name="name">res.partner.denomination.list</field>
        <field name="model">res.partner.denomination</field>
        <field name="arch" type="xml">
            <list string="Denominations" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_res_partner_denomination" model="ir.actions.act_window">
        <field name="name">Denominations</field>
        <field name="res_model">res.partner.denomination</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_partner_denomination"
        action="action_res_partner_denomination"
        name="Denominations"
        parent="contacts.res_partner_menu_config"
        sequence="4"
